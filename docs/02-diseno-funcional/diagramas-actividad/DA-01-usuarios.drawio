=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n12"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e16" value="No / vencido" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n13"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e17" value="Reintento" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="n10"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e18" value="Abandona" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="z"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n12" target="z"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n14" target="z"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n15" target="z"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n16" target="z"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="DA-02" name="DA-02 — Autenticación y recuperación"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1225" pageHeight="2643"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="DA-02 | Autenticación y recuperación · v1.0" style="text;html=1;fontSize=23;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="15" width="1125.2250000000001" height="40" /></mxCell><mxCell id="refs" value="CU-US-03/04/05/06/07/08/09 · HU-US-02/03/04 · RF-US-01/02/04 · RF-PE-03" style="text;html=1;whiteSpace=wrap;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="60" width="1125.2250000000001" height="75" /></mxCell><mxCell id="s" value="" style="ellipse;fillColor=#263238;strokeColor=#263238;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="373.574784" y="149.999784" width="29.700432" height="29.700432" /></mxCell><mxCell id="z" value="" style="ellipse;shape=doubleEllipse;fillColor=#263238;strokeColor=#263238;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="762.374784" y="2543.5497840000003" width="29.700432" height="29.700432" /></mxCell><mxCell id="n1" value="Usuario: ¿acceso o recuperación?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="223.04892" y="245.85108" width="330.75216" height="106.64784000000002" /></mxCell><mxCell id="n2" value="Sistema: validar contraseña/hash o Google OIDC; limitar intentos" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="194.69892000000004" y="1471.650108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n3" value="¿Credenciales válidas y cuenta habilitada?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="194.69892000000004" y="1639.05108" width="330.75216" height="106.64784000000002" /></mxCell><mxCell id="n4" value="Sistema: correo pendiente → DA-01; desactivada → DA-03; eliminación pendiente → bloquear acceso habitual y permitir solo trámite de desistimiento con identidad acreditada; temporal → ECU-07; inválida → respuesta genérica" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="29.99892" y="1945.5001080000002" width="330.75216" height="108" /></mxCell><mxCell id="n5" value="Sistema: aplicar permisos y TOTP administrativo según ECU-07" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="270.29892" y="1830.7501080000002" width="330.75216" height="82.349784" /></mxCell><mxCell id="n6" value="Sistema: crear sesión segura; jugador 30 días; admin 7 días máximo y bloqueo 30 min inactivo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="270.29892" y="2060.250108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n7" value="Usuario: cerrar sesión; sistema invalida sesión y limpia cookie" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="432.29892000000007" y="2395.0501080000004" width="330.75216" height="82.349784" /></mxCell><mxCell id="n8" value="Usuario: solicitar recuperación por correo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="517.34892" y="437.550108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n9" value="Sistema: respuesta uniforme; si procede emitir token único 15 min y enviar por Brevo; limitar solicitudes" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="602.3989200000001" y="586.050108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n10" value="¿Token vigente, válido y no usado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="602.3989200000001" y="753.45108" width="330.75216" height="106.64784000000002" /></mxCell><mxCell id="n11" value="Usuario: ingresar nueva contraseña; sistema valida mínimo 8 y bloquea inseguras" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="422.84892" y="945.150108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n12" value="¿Contraseña válida?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="422.84892" y="1112.55108" width="330.75216" height="106.64784000000002" /></mxCell><mxCell id="n13" value="Sistema: guardar hash, consumir token y revocar sesiones atómicamente; no eludir TOTP" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="422.84892" y="1304.2501080000002" width="330.75216" height="82.349784" /></mxCell><mxCell id="n14" value="Sistema: denegar o revertir ante fallo; permitir nueva solicitud limitada" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="649.6489200000001" y="2060.250108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n15" value="Usuario autenticado: vincular método o cambiar contraseña; reautenticar y validar control/unicidad; no fusionar cuentas" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="432.29892000000007" y="2227.6501080000003" width="330.75216" height="82.349784" /></mxCell