parent="1"><mxGeometry as="geometry" x="29.99892" y="586.050108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n4" value="¿Respuesta válida y sin vínculo previo?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="29.99892" y="753.45108" width="330.75216" height="106.64784000000002" /></mxCell><mxCell id="n5" value="Visitante: completar datos obligatorios; contraseña si corresponde" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="270.29892" y="945.150108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n6" value="Sistema: validar edad ≥18, datos, unicidad y contraseña segura si corresponde" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="270.29892" y="1174.650108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n7" value="¿Datos válidos e identidad libre?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="270.29892" y="1323.15108" width="330.75216" height="106.64784000000002" /></mxCell><mxCell id="n8" value="Sistema: crear jugador y cuenta atómicamente; hash si corresponde; teléfono no verificado" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="540.2989200000001" y="1514.850108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n9" value="¿Persistencia exitosa?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="642.8989200000001" y="1744.3510800000001" width="330.75216" height="106.64784000000002" /></mxCell><mxCell id="n10" value="Sistema: emitir token de 24 h; Brevo envía enlace" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="642.8989200000001" y="1936.0501080000001" width="330.75216" height="82.349784" /></mxCell><mxCell id="n11" value="¿Correo verificado mediante prueba válida?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="679.34892" y="2165.55108" width="330.75216" height="106.64784000000002" /></mxCell><mxCell id="n12" value="Sistema: activar cuenta y consumir token si corresponde, atómicamente" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="749.5489200000001" y="2357.250108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n13" value="Sistema: mantener pendiente; permitir reemisión limitada si vence o falla envío" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="370.19892000000004" y="2357.250108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n14" value="Sistema: rechazar datos inválidos o duplicados. Si existe identidad invitada, exigir prueba de titularidad antes de vincular; mecanismo gratuito pendiente. No crear duplicado ni transferir historial sin prueba." style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="248.69892000000004" y="1629.600108" width="330.75216" height="110" /></mxCell><mxCell id="n15" value="Sistema: derivar a DA-02 si vínculo existente; si respuesta inválida, denegar" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="29.99892" y="1059.900108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n16" value="Sistema: revertir y no confirmar éxito" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="898.04892" y="2050.8001080000004" width="330.75216" height="82.349784" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s" target="n1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1" target="n2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2" target="n3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2" target="n5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n15"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogon