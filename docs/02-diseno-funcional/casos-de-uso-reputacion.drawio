        <mxCell id="e3" value="" style="html=1;strokeColor=#475569;endArrow=none;" edge="1" parent="1" source="user" target="view">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n1" value="RF-RE-01 / 02 · Confirmados al inicio: presentes por defecto, salvo bajas o expulsiones. El organizador registra ausencias desde el fin programado hasta 24 h después. Al vencer, se consolida la asistencia." style="shape=note;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#fff7df;strokeColor=#b59b54;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="330" y="650" width="420" height="180" />
        </mxCell>
        <mxCell id="n2" value="Cálculo automático: (5 × presencias + 3 × bajas tardías + ausencias) / eventos computables. Excluir bajas con al menos 1 h, expulsiones y partidos cancelados. Sin eventos: sin valoración." style="shape=note;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#fff7df;strokeColor=#b59b54;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="790" y="650" width="420" height="180" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
