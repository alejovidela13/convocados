          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="«include»" style="html=1;strokeColor=#475569;endArrow=none;dashed=1;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="abs" target="window">
          <mxGeometry as="geometry" relative="1" />
