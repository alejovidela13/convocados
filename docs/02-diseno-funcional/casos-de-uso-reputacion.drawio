        </mxCell>
        <mxCell id="abs" value="Registrar ausencias" style="ellipse;whiteSpace=wrap;html=1;fontSize=15;fillColor=#eaf2f8;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="330" y="200" width="270" height="80" />
        </mxCell>
        <mxCell id="window" value="Validar plazo de 24 h y partido realizado" style="ellipse;whiteSpace=wrap;html=1;fontSize=15;fillColor=#eaf2f8;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="790" y="200" width="270" height="80" />
        </mxCell>
        <mxCell id="view" value="Consultar promedio de asistencia" style="ellipse;whiteSpace=wrap;html=1;fontSize=15;fillColor=#eaf2f8;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="330" y="490" width="270" height="80" />
