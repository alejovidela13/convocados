        </mxCell>
        <mxCell id="n1" value="RF-RE-03 / 04 · Solo presentes del mismo partido, sin autoevaluación ni votos duplicados. Plazo: 24 h desde el fin programado. Invitados: acceso con token personal válido como precondición." style="shape=note;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#fff7df;strokeColor=#b59b54;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="280" width="390" height="170" />
        </mxCell>
        <mxCell id="n2" value="Puntualidad, juego limpio, actitud y nivel futbolístico: 1 a 5. Mostrar promedios separados; autor interno, no público. Invalidar votos emitidos o recibidos por ausentes. Sin reclamos." style="shape=note;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#fff7df;strokeColor=#b59b54;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="520" width="390" height="200" />
        </mxCell>
