        <mxCell id="boundary" value="Convocados | DCU-04A · Asistencia | v1.0" style="rounded=0;html=1;verticalAlign=top;fontStyle=1;fontSize=20;fillColor=none;strokeColor=#334155;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="230" y="45" width="1040" height="900" />
