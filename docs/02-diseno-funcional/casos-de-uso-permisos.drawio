          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note" value="RF-US-07 · ACT-04 · RNF-03&lt;br&gt;Verificación personal de autorización antes del alta. Un establecimiento admite varios administradores; cada administrador gestiona uno solo. La revocación retira el permiso administrativo, no implica eliminar la identidad del jugador. Reautenticar para otorgar/revocar permisos y modificar credenciales; sesión máxima 7 días." style="shape=note;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="770" width="900" height="170" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
