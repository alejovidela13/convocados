          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note" value="RF-US-07 · RNF-03 · CA-11&lt;br&gt;La gestión se habilita solo después del cambio de contraseña y la verificación del correo. Verificar autorización y propiedad del recurso en cada operación, incluso por URL directa. El gestor inicial se configura de forma segura fuera del flujo habitual de altas. Reautenticar para otorgar/revocar permisos y modificar credenciales; sesión máxima 7 días." style="shape=note;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="760" width="910" height="175" />
        </mxCell>
