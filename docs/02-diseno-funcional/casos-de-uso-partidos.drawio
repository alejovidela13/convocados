        </mxCell>
        <mxCell id="automatic" value="Regla automática al inicio: si no hay reserva válida, cancelar partido y vencer solicitud pendiente. No es una acción de un actor humano." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
