<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="DE-01" name="DE-01 — Ciclo de vida de cuenta"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1806" pageHeight="1235"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="DE-01 | Ciclo de vida de cuenta · v1.0" style="text;html=1;fontSize=23;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="15" width="1706.9400000000003" height="40" /></mxCell><mxCell id="refs" value="CU-US-01/02/04/15/16/17 · HU-US-01/03/08/09 · RF-US-01/09 · RNF-05. Estados conceptuales; sesión, correo y permisos independientes." style="text;html=1;whiteSpace=wrap;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="60" width="1706.9400000000003" height="75" /></mxCell><mxCell id="s" value="" style="ellipse;fillColor=#263238;strokeColor=#263238;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="760.835784" y="176.32478400000002" width="29.700432" height="29.700432" /></mxCell><mxCell id="z" value="" style="ellipse;shape=doubleEllipse;fillColor=#263238;strokeColor=#263238;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="918.785784" y="1135.4997839999999" width="29.700432" height="29.700432" /></mxCell><mxCell id="n1" value="Pendiente de verificación" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.30992" y="317.40010800000005" width="330.75216" height="82.349784" /></mxCell><mxCell id="n2" value="Activa" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.30992" y="484.800108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n3" value="Desactivada reversible" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.30992" y="652.200108" width="330.75216" height="82.349784" /></mxCell><mxCell id="n4" value="Eliminación pendiente" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="768.2599200000001" y="819.6001080000001" width="330.75216" height="82.349784" /></mxCell><mxCell id="n5" value="Eliminada definitivamente" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="768.2599200000001" y="987.0001080000002" width="330.75216" height="82.349784" /></mxCell><mxCell id="n6" value="Eliminación pendiente: acceso habitual bloqueado, sesiones revocadas. Desistimiento con identidad acreditada antes del vencimiento. Retorno al estado previo propuesto; sin restaurar permisos ni sesiones. Persistencia por definir." style="shape=note;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="839.80992" y="150.000108" width="330.75216" height="145" /></mxCell><mxCell id="e0" value="Alta válida" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s" target="n1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="Correo verificado + requisitos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1" target="n2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="Reemisión / token vencido" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1" target="n1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="Baja [compromisos resueltos y permisos revocados] / revocar sesiones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2" target="n3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="Acceso válido + confirmación" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="Solicitud verificada [compromisos resueltos y permisos revocados] / bloquear acceso y revocar sesiones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2" target="n4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="Solicitud verificada / bloquear acceso y revocar sesiones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="30 días [sin desistimiento válido] / eliminación o anonimización según obligaciones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="z"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="Desistimiento válido antes del vencimiento [estado previo activo]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="Desistimiento válido antes del vencimiento [estado previo desactivado]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>